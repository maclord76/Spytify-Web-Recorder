{
  "manifest_version": 3,
  "name": "Spytify Web Recorder",
  "description": "Enregistre localement le son de l'onglet Spotify Web actif, sans programme compagnon.",
  "version": "1.18.5",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "downloads",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://*.scdn.co/*",
    "https://*.spotifycdn.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Spytify Web Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["spotify-player.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
